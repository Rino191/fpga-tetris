NET "vga_r"   LOC = "H14" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST ;
NET "vga_g" LOC = "H15" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST ;
NET "vga_b"  LOC = "G15" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST ;
NET "vga_hsync" LOC = "F15" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST ;
NET "vga_vsync" LOC = "F14" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST ;
NET "clk" LOC = "C9"  | IOSTANDARD = LVCMOS33 ;
NET "right" LOC = "H13" | IOSTANDARD = LVTTL | PULLDOWN ;
NET "left" LOC = "D18" | IOSTANDARD = LVTTL | PULLDOWN ;
NET "rotate" LOC = "V4" | IOSTANDARD = LVTTL | PULLDOWN;
NET "drop_button" LOC = "K17" | IOSTANDARD = LVTTL | PULLDOWN;
NET "reset" LOC = "V16" | IOSTANDARD = LVTTL | PULLDOWN;
